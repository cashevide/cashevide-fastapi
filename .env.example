COMPOSE_PROJECT_NAME=cashevide-fastapi

DEBUG = True

# --- DATABASE SETTINGS ---
DB_NAME=cashevide_db
DB_USER=admin
DB_PASSWORD=strongpassword123
DB_HOST=localhost
DB_PORT=5432
DB_ECHO=True

JWT_SECRET_KEY=<random string>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=5
JWT_REFRESH_TOKEN_EXPIRE_DAYS=90

# --- COOKIE SETTINGS ---
# Comment this out for development.
# COOKIE_DOMAIN=.cashevide.com

CORS_ALLOWED_ORIGINS=https://v2.cashevide.com

# --- CLOUDFLARE R2 MEDIA STORAGE ---
# Set to 'True' in production to use Cloudflare R2.
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_STORAGE_BUCKET_NAME=cashevide-media
AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
MEDIA_BASE_URL=http://localhost:8001/media/
MAX_IMAGE_UPLOAD_MB=10

# --- FASTAPI ADMIN SETTINGS ---
ADMIN_EMAIL=noufal@email.com
ADMIN_USERNAME=noufal
ADMIN_PASSWORD=noufal
