### Signup

POST {{base_url}}/users/signup
Content-Type: application/json

{
  "email": "test11@email.com",
  "password": "noufal123",
  "username": "test11"
}



### Login

POST {{base_url}}/users/login
Content-Type: application/json

{
  "email": "test@email.com",
  "password": "noufalka123",
  "platform": "mobile"
}

> {%
  var cookieHeader = response.headers.valueOf("Set-Cookie");

  if (cookieHeader) {
      var match = cookieHeader.match(/access_token=([^;]+)/);

      if (match) {
          client.global.set("token", match[1]);
      }
  }
  else{
      client.global.set("token", response.body.access)
      client.global.set("refresh", response.body.refresh)
    }
%}
